spectra 22 "Bouncing Ball" {
    active camera=1 film=1 sampler=1
    transport maximum-depth=8
    geometries {
        sphere 1 "Ball Shape" radius=0.35
        box 2 "Floor Shape" {
            bounds -4 -0.12 -4 4 0 4
        }
    }
    materials {
        diffuse 1 "Ball Material" {
            reflectance rgb-albedo 0.12 0.42 0.92
        }
        diffuse 2 "Floor Material" {
            reflectance rgb-albedo 0.42 0.44 0.48
        }
    }
    lights {
        point 1 "Key Light" {
            intensity rgb-illuminant 70 67 62
            transform {
                row 1 0 0 3.5
                row 0 1 0 6
                row 0 0 1 4
                row 0 0 0 1
            }
            scale 0.009358316
        }
        infinite 2 "Environment" {
            radiance rgb-illuminant 0.035 0.045 0.06
            scale 0.009358316
        }
    }
    cameras {
        perspective 1 "Main Camera" {
            transform {
                row 0.7863183 -0.16081972 0.59652364 5.5
                row 0 0.96552736 0.26030123 3.8
                row -0.6178216 -0.20467962 0.7592119 7
                row 0 0 0 1
            }
            vertical-fov 42
        }
    }
    films {
        film 1 "Main Film" gbuffer=#true {
            resolution 1920 1080
            filter gaussian radius-x=1.5 radius-y=1.5
        }
    }
    samplers {
        sampler 1 "Main Sampler" kind="pmj02bn" samples=256 seed=20260731
    }
    prototypes {
        prototype 1 "Ball Prototype" {
            primitive geometry=1 material=1
        }
        prototype 2 "Floor Prototype" {
            primitive geometry=2 material=2
        }
    }
    instances {
        instance 1 "Ball" prototype=1
        instance 3 "Initial Ball State" prototype=1 visible=#false {
            transform {
                row 1 0 0 0
                row 0 1 0 3
                row 0 0 1 0
                row 0 0 0 1
            }
        }
        instance 2 "Floor" prototype=2
    }
    dynamics seed=20260802 {
        system "ball" "Bouncing Ball" provider="xayah.rigid.bouncing-ball" {
            bind "collider" instance 2
            bind "initial_ball" instance 3
            bind "ball_transform" instance 1
            bind "debug" instance 1
        }
    }
}
