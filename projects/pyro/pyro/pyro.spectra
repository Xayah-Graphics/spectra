spectra 22 "Pyro" {
    active camera=1 film=1 sampler=1
    transport maximum-depth=8
    geometries {
        box 1 "Pyro Bounds" {
            bounds -0.6 0 -0.6 0.6 1.8 0.6
        }
    }
    volumes {
        density-grid 1 "Pyro" asset="e03c850c73e5403937f4b200ab35fb9d5f56afa663b0f2a812d9145a99f34577" {
            bounds -0.6 0 -0.6 0.6 1.8 0.6
            resolution 64 96 64
        }
    }
    materials {
        interface 1 "Volume Boundary"
    }
    media {
        volume 1 "Pyro Medium" volume=1 {
            sigma-a rgb-unbounded 0.18 0.2 0.24
            sigma-s rgb-unbounded 0.75 0.72 0.68
            emission rgb-illuminant 1 0.56 0.14
            emission-scale 0.009358316
            anisotropy 0.15
            temperature-scale 55
            temperature-offset 300
            minimum-emission-temperature 700
            blackbody-emission #true
        }
    }
    lights {
        point 1 "Key Light" {
            intensity rgb-illuminant 70 67 62
            transform {
                row 1 0 0 3.5
                row 0 1 0 6
                row 0 0 1 4
                row 0 0 0 1
            }
            scale 0.009358316
        }
        infinite 2 "Environment" {
            radiance rgb-illuminant 0.035 0.045 0.06
            scale 0.009358316
        }
    }
    cameras {
        perspective 1 "Main Camera" {
            transform {
                row 0.8073911 -0.1253278 0.57655233 3.8
                row 0 0.9771798 0.21241401 2.3
                row -0.5900166 -0.17150119 0.7889663 5.2
                row 0 0 0 1
            }
            vertical-fov 42
        }
    }
    films {
        film 1 "Main Film" gbuffer=#true {
            resolution 1920 1080
            filter gaussian radius-x=1.5 radius-y=1.5
        }
    }
    samplers {
        sampler 1 "Main Sampler" kind="pmj02bn" samples=256 seed=20260731
    }
    prototypes {
        prototype 1 "Pyro Volume Prototype" {
            primitive geometry=1 volume=1 material=1 {
                media inside=1
            }
        }
    }
    instances {
        instance 1 "Pyro Volume" prototype=1
    }
    dynamics seed=20260802 {
        system "pyro" "Pyro Simulation" provider="xayah.volume.pyro" {
            bind "initial_volume" volume 1
            bind "volume" volume 1
        }
    }
}
