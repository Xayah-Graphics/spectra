#include "camera_uniform.slangh"

struct SelectionPushConstants {
    row_major float4x4 model;
    float4 color;
    float4 base_color;
    float4 material;
    uint4 flags;
};

[[vk::binding(0, 0)]] ConstantBuffer<CameraUniform> camera;
[[vk::binding(0, 1)]] Texture2D<float4> baseColorTexture;
[[vk::binding(4, 1)]] SamplerState materialSampler;
[[vk::push_constant]] ConstantBuffer<SelectionPushConstants> selection;

static const uint PreviewAlphaModeMaskedValue = 1;

struct VertexInput {
    [[vk::location(0)]] float3 position : POSITION;
    [[vk::location(2)]] float2 uv : TEXCOORD;
};

struct VertexOutput {
    float4 position : SV_Position;
    [[vk::location(0)]] float2 uv : TEXCOORD;
};

[shader("vertex")]
VertexOutput vertex_main(VertexInput input) {
    VertexOutput output;
    float4 world = mul(float4(input.position, 1.0), selection.model);
    output.position = mul(world, camera.worldToClip);
    output.uv = input.uv;
    return output;
}

void apply_mesh_alpha_mask(VertexOutput input) {
    float alpha = (selection.flags.z & 1) != 0 ? baseColorTexture.Sample(materialSampler, float2(input.uv.x, 1.0 - input.uv.y)).a * selection.base_color.a : selection.base_color.a;
    if (selection.flags.y == PreviewAlphaModeMaskedValue && alpha < selection.material.z) discard;
}
