#include "camera_uniform.slangh"

static const uint invalidVolumeChannelSlot = 0xffffffffu;

struct VolumeSelectionPushConstants {
    float4 originMode;
    float4 extentStepScale;
    float4 opacityScaleBias;
    uint4 channelSlots;
    uint4 channelComponents;
    float4 color;
    uint4 object;
};

[[vk::binding(0, 0)]] ConstantBuffer<CameraUniform> camera;
[[vk::binding(1, 0)]] Texture3D<float4> volumeChannels[16];
[[vk::binding(2, 0)]] SamplerState volumeSampler;
[[vk::push_constant]] ConstantBuffer<VolumeSelectionPushConstants> volume;

struct VertexOutput {
    float4 position : SV_Position;
    [[vk::location(0)]] float3 localPosition : TEXCOORD0;
};

uint volume_cube_index(uint vertexIndex) {
    static const uint indices[36] = {
        0, 1, 2, 0, 2, 3,
        5, 4, 7, 5, 7, 6,
        4, 0, 3, 4, 3, 7,
        1, 5, 6, 1, 6, 2,
        3, 2, 6, 3, 6, 7,
        4, 5, 1, 4, 1, 0,
    };
    return indices[vertexIndex % 36];
}

float3 volume_cube_corner(uint cornerIndex) {
    return float3(float((cornerIndex ^ (cornerIndex >> 1u)) & 1u), float((cornerIndex >> 1u) & 1u), float((cornerIndex >> 2u) & 1u));
}

[shader("vertex")]
VertexOutput vertex_main(uint vertexIndex : SV_VertexID) {
    float3 localPosition = volume_cube_corner(volume_cube_index(vertexIndex));
    float3 worldPosition = volume.originMode.xyz + localPosition * volume.extentStepScale.xyz;
    VertexOutput output;
    output.position = mul(float4(worldPosition, 1.0), camera.worldToClip);
    output.localPosition = localPosition;
    return output;
}

float2 intersect_volume_unit_box(float3 rayOrigin, float3 rayDirection) {
    float3 inverseDirection = 1.0 / rayDirection;
    float3 t0 = -rayOrigin * inverseDirection;
    float3 t1 = (float3(1.0, 1.0, 1.0) - rayOrigin) * inverseDirection;
    float3 nearT = min(t0, t1);
    float3 farT = max(t0, t1);
    return float2(max(max(nearT.x, nearT.y), nearT.z), min(min(farT.x, farT.y), farT.z));
}

float select_volume_component(float4 value, uint component) {
    if (component == 0u) return value.x;
    if (component == 1u) return value.y;
    if (component == 2u) return value.z;
    return value.w;
}

float sample_selection_opacity(float3 samplePosition) {
    bool scalarDebug = uint(volume.originMode.w + 0.5) == 1u;
    uint slot = scalarDebug ? volume.channelSlots.w : volume.channelSlots.x;
    uint component = (scalarDebug ? volume.channelComponents.w : volume.channelComponents.x) & 0xffu;
    if (slot == invalidVolumeChannelSlot) return 0.0;
    float4 value = volumeChannels[slot].SampleLevel(volumeSampler, samplePosition, 0.0);
    return max(select_volume_component(value, component) * volume.opacityScaleBias.x + volume.opacityScaleBias.y, 0.0);
}

float raymarch_selection_opacity(VertexOutput input) {
    float3 extent = volume.extentStepScale.xyz;
    float3 cameraLocal = (camera.cameraPosition.xyz - volume.originMode.xyz) / extent;
    float3 rayDirection = normalize(input.localPosition - cameraLocal);
    float2 interval = intersect_volume_unit_box(cameraLocal, rayDirection);
    if (interval.y <= max(interval.x, 0.0)) return 0.0;
    float startT = max(interval.x, 0.0);
    float endT = interval.y;
    float stepLength = max((endT - startT) / 96.0, 0.001);
    float stepWorldLength = length(rayDirection * extent) * stepLength;
    float accumulatedAlpha = 0.0;
    for (int stepIndex = 0; stepIndex < 128; ++stepIndex) {
        float t = startT + (float(stepIndex) + 0.5) * stepLength;
        if (t > endT || accumulatedAlpha > 0.55) break;
        float alpha = saturate(1.0 - exp(-sample_selection_opacity(cameraLocal + rayDirection * t) * stepWorldLength));
        accumulatedAlpha += (1.0 - accumulatedAlpha) * alpha;
    }
    return accumulatedAlpha;
}
