uint volume_part1by2(uint value) {
    value &= 0x000003ffu;
    value = (value | (value << 16u)) & 0x030000ffu;
    value = (value | (value << 8u)) & 0x0300f00fu;
    value = (value | (value << 4u)) & 0x030c30c3u;
    value = (value | (value << 2u)) & 0x09249249u;
    return value;
}

uint volume_source_index(uint3 coordinate, uint3 dimensions, bool mortonOrder) {
    uint linearIndex = coordinate.x + dimensions.x * (coordinate.y + dimensions.y * coordinate.z);
    if (!mortonOrder) return linearIndex;
    return volume_part1by2(coordinate.x) | (volume_part1by2(coordinate.y) << 1u) | (volume_part1by2(coordinate.z) << 2u);
}
